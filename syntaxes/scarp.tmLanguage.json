{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Scarp",
  "scopeName": "source.scarp",
  "fileTypes": [
    "srp"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control"
    },
    {
      "include": "#logic"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.scarp",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.scarp",
          "begin": "\"",
          "end": "\"|(?=$)",
          "patterns": [
            {
              "name": "constant.character.escape.scarp",
              "match": "\\\\(?:\\\\|\"|n|t|r|u\\{[0-9A-Fa-f]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.scarp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(funcra)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.scarp"
            },
            "3": {
              "name": "entity.name.function.definition.scarp"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.modifier.scarp",
          "match": "\\b(?:bind|var|pub|pure|import)\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.scarp",
          "match": "\\b(?:if|elif|else|while|repeat|as|return|break|continue|assert)\\b"
        }
      ]
    },
    "logic": {
      "patterns": [
        {
          "name": "keyword.operator.logical.scarp",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.scarp",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.scarp",
          "match": "\\barray\\b(?=\\s*:)"
        },
        {
          "name": "support.type.scarp",
          "match": "\\b(?:tuple|array)\\b(?=\\s*<)"
        },
        {
          "name": "support.type.scarp",
          "match": "\\bbigint\\b(?!\\s*\\()"
        },
        {
          "name": "support.type.scarp",
          "match": "\\b(?:integer|float|boolean|string|unit|vector|tile)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.scarp",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.scarp",
          "match": "\\b(?:print|println|write|eprint|ewrite|topk|topk_values|softmax_temp|logsoftmax_temp|sample_area|sample_slopes|sample_cumulative_area|cosine_similarity|top_p|top_p_values|pearson_correlation|read_line|integer_to_text|float_to_text|text_to_integer|text_to_float|text_trim|text_replace|bigint|bigint_from_integer|bigint_to_integer|bigint_abs|read_line_or|try_read_line|ask|ask_or|input|input_integer|input_float|input_bigint|flush_stdout|flush_stderr|bigint_pow|bigint_gcd|bigint_lcm|bigint_sqrt|bigint_bit_length|bigint_to_text|bigint_from_radix|bigint_to_radix|bigint_and|bigint_or|bigint_xor|bigint_not|bigint_shl|bigint_shr|bigint_pow_mod|bigint_divmod)\\b(?=\\s*\\()"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.scarp",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.scarp",
          "match": ">>>=|>>=|<<=|>>>|>>|<<|->|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[+\\-*/%&|^~=<>(){}\\[\\]:;,.]"
        }
      ]
    }
  }
}
