{
  "name": "scarp",
  "displayName": "Scarp Compiler & Runner",
  "description": "Official experimental Scarp VS Code tools: syntax highlighting, project workflow, static verification, navigation and interpreter-backed execution.",
  "publisher": "ScarpLang",
  "version": "0.1.6",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scarp-lang/scarp-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/scarp-lang/scarp-vscode/issues"
  },
  "homepage": "https://github.com/scarp-lang/scarp-vscode#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "scarp",
    "srp",
    "compiler",
    "runner",
    "language"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onLanguage:scarp",
    "onCommand:scarp.explainDiagnostic",
    "onCommand:scarp.createProject",
    "onCommand:scarp.verifyProject",
    "onCommand:scarp.launchProject",
    "onCommand:scarp.reconcileProjects",
    "onCommand:scarp.browseProjectModules",
    "onCommand:scarp.browseProjectSymbols",
    "onCommand:scarp.testProject",
    "onCommand:scarp.testProjectFiltered",
    "onCommand:scarp.listProjectTests",
    "onCommand:scarp.listFilteredProjectTests",
    "onCommand:scarp.initProject"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scarp",
        "aliases": [
          "Scarp"
        ],
        "extensions": [
          ".srp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "scarp.runFile",
        "title": "Scarp: Run Current File",
        "category": "Scarp"
      },
      {
        "command": "scarp.checkFile",
        "title": "Scarp: Verify Current File",
        "category": "Scarp"
      },
      {
        "command": "scarp.showVersion",
        "title": "Scarp: Show Compiler Version",
        "category": "Scarp"
      },
      {
        "command": "scarp.explainDiagnostic",
        "title": "Scarp: Explain Diagnostic Code",
        "category": "Scarp"
      },
      {
        "command": "scarp.stopProgram",
        "title": "Scarp: Stop Running Program",
        "category": "Scarp"
      },
      {
        "command": "scarp.showOutput",
        "title": "Scarp: Show Compiler Output",
        "category": "Scarp"
      },
      {
        "command": "scarp.createProject",
        "title": "Scarp: Create Project",
        "category": "Scarp"
      },
      {
        "command": "scarp.verifyProject",
        "title": "Scarp: Verify Project",
        "category": "Scarp"
      },
      {
        "command": "scarp.browseProjectModules",
        "title": "Scarp: Browse Project Modules",
        "category": "Scarp"
      },
      {
        "command": "scarp.browseProjectSymbols",
        "title": "Scarp: Browse Project Symbols",
        "category": "Scarp"
      },
      {
        "command": "scarp.reconcileProjects",
        "title": "Scarp: Check Verified Project Diagnostic Freshness",
        "category": "Scarp"
      },
      {
        "command": "scarp.launchProject",
        "title": "Scarp: Launch Project",
        "category": "Scarp"
      },
      {
        "command": "scarp.testProject",
        "title": "Scarp: Run Project Tests",
        "category": "Scarp"
      },
      {
        "command": "scarp.testProjectFiltered",
        "title": "Scarp: Run Filtered Project Tests",
        "category": "Scarp"
      },
      {
        "command": "scarp.listProjectTests",
        "title": "Scarp: List Project Tests",
        "category": "Scarp"
      },
      {
        "command": "scarp.listFilteredProjectTests",
        "title": "Scarp: List Filtered Project Tests",
        "category": "Scarp"
      },
      {
        "command": "scarp.initProject",
        "title": "Scarp: Initialize Modern Project",
        "category": "Scarp"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "scarp.runFile",
          "when": "resourceExtname == .srp && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "scarp.checkFile",
          "when": "resourceExtname == .srp && isWorkspaceTrusted",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "scarp.explainDiagnostic",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.runFile",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.checkFile",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.showVersion",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.createProject",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.verifyProject",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.browseProjectModules",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.browseProjectSymbols",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.reconcileProjects",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.launchProject",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.testProject",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.testProjectFiltered",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.listProjectTests",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.listFilteredProjectTests",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "scarp.initProject",
          "when": "isWorkspaceTrusted"
        }
      ]
    },
    "configuration": {
      "title": "Scarp",
      "properties": {
        "scarp.compilerPath": {
          "type": "string",
          "default": "scarp",
          "scope": "machine",
          "description": "Absolute path to the official Scarp executable, or scarp when it is on PATH."
        },
        "scarp.checkTimeoutMs": {
          "type": "integer",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Timeout for non-interactive compiler checks and version detection (milliseconds)."
        },
        "scarp.maxSteps": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-steps execution budget for run/check."
        },
        "scarp.maxPrints": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-prints execution budget for run/check."
        },
        "scarp.maxCalls": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-calls budget for run/check."
        },
        "scarp.maxCallDepth": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-call-depth budget for run/check."
        },
        "scarp.maxLiveSlots": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-live-slots budget for run/check."
        },
        "scarp.maxCaptureBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-capture-bytes budget for run/check."
        },
        "scarp.maxVectorBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-vector-bytes budget for run/check."
        },
        "scarp.verifyOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Automatically run non-executing Scarp static verification after saving a .srp file in a trusted workspace. Requires a compiler exposing 'scarp verify' (v0.0.5-alpha.3+). Never runs the older evaluating check on save."
        },
        "scarp.maxTextBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-text-bytes budget for Scarp interpreter execution and project launching (supported by Scarp v0.0.5-alpha.4)."
        },
        "scarp.maxTupleBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-tuple-bytes execution limit (Cumulative tuple payload quota). Supported by Scarp v0.0.6-alpha.6+; earlier compilers do not accept this flag. Input requires redirected/piped stdin, not a connected terminal."
        },
        "scarp.maxInputLineBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-input-line-bytes execution limit (Per-line raw UTF-8 input quota, including CR/LF). Supported by Scarp v0.0.6-alpha.6+; earlier compilers do not accept this flag. Input requires redirected/piped stdin, not a connected terminal."
        },
        "scarp.maxInputBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-input-bytes execution limit (Cumulative raw UTF-8 input quota). Supported by Scarp v0.0.6-alpha.6+; earlier compilers do not accept this flag. Input requires redirected/piped stdin, not a connected terminal."
        },
        "scarp.maxInputReads": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional --max-input-reads execution limit (Number of selected read_line calls, including EOF attempts). Supported by Scarp v0.0.6-alpha.6+; earlier compilers do not accept this flag. Input requires redirected/piped stdin, not a connected terminal."
        },
        "scarp.showFileActionsCodeLens": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Opt in to Run Scarp File and Verify Scarp File CodeLens shortcuts above each .srp document in trusted workspaces. No compiler is launched merely by displaying the lenses."
        },
        "scarp.requireNonemptyProjectTests": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Require at least one selected test when explicitly running a Scarp project test suite (published compiler v0.0.6-alpha.8+). Adds --require-tests to both full-suite and filename-filtered test commands. An empty or unmatched suite then fails instead of reporting success. No automatic test execution."
        }
      }
    },
    "grammars": [
      {
        "language": "scarp",
        "scopeName": "source.scarp",
        "path": "./syntaxes/scarp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "scarp",
        "path": "./snippets/scarp.code-snippets"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "vscode:prepublish": "npm run build",
    "package:pre": "vsce package --pre-release --no-dependencies",
    "test:integration": "npm run build && node dist/test/integration/runTest.js",
    "test:untrusted": "npm run build && node dist/test/integration/runUntrustedTest.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.0.2",
    "eslint": "^9.25.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.0",
    "@vscode/test-electron": "^3.1.0",
    "vscode-textmate": "^9.2.0",
    "vscode-oniguruma": "^2.0.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting, local Outline and read-only built-in signature hovers remain available in Restricted Mode. Compiler verification, execution, project commands and compiler-backed navigation require a trusted workspace."
    }
  }
}
